/*
 * BUG//REPORT game UI (UI Toolkit). Reference resolution 1920x1080 (PS_BugReport).
 * Built in code by the UI layers in Scripts/Runtime/UI; element names and classes are
 * the hooks used here. Palette: cyan system accent, red containment, green success.
 */

.br-root {
    --br-accent: #40F2FF;
    --br-text: #DFF7FF;
    --br-text-soft: #CDEAF5;
    --br-text-dim: #7FA3B5;
    --br-alert: #FF4057;
    --br-success: #7CFFB2;
    --br-panel: rgba(5, 12, 20, 0.78);
    font-size: 16px;
    color: var(--br-text);
}

.br-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Resets the theme's label spacing. Declared first and with a single class, so any later
   class rule (.br-key, .br-title, ...) can set its own margin/padding. A descendant selector
   here (".br-root Label") would outrank those rules and silently remove their spacing. */
.br-label {
    padding: 0;
    margin: 0;
}

/* ---------------------------------------------------------------- shared */

.br-panel {
    background-color: var(--br-panel);
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: var(--br-accent);
    padding: 12px 16px;
}

.br-hud--no-panels .br-panel {
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
}

.br-caption {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--br-text-dim);
}

.br-key {
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #0A1620;
    background-color: var(--br-text-soft);
    border-radius: 3px;
    padding: 2px 6px;
    margin-right: 8px;
    min-width: 22px;
}

/* ---------------------------------------------------------------- containment (top) */

.br-alert {
    position: absolute;
    top: 16px;
    left: 50%;
    width: 440px;
    translate: -50% 0;
    align-items: center;
}

.br-alert__stage {
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--br-alert);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.6);
}

.br-alert--flash .br-alert__stage {
    color: #FFFFFF;
}

.br-alert__track {
    width: 100%;
    height: 6px;
    margin-top: 6px;
    border-radius: 3px;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.18);
}

.br-alert__fill {
    height: 100%;
    background-color: #FFFFFF;
}

.br-alert--stage1 .br-alert__fill { background-color: #FFD24A; }
.br-alert--stage2 .br-alert__fill { background-color: #FF9A3D; }
.br-alert--stage3 .br-alert__fill { background-color: var(--br-alert); }
.br-alert--stage4 .br-alert__fill { background-color: #FF1F4B; }

.br-alert__detail {
    margin-top: 4px;
    font-size: 14px;
    -unity-font-style: bold;
    color: #FFB3BD;
}

/* ---------------------------------------------------------------- reticle (centre) */

.br-reticle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 26px;
    height: 26px;
    translate: -50% -50%;
    transition-property: scale;
    transition-duration: 0.12s;
}

.br-reticle__tick,
.br-reticle__dot {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.6);
}

.br-reticle__tick--left  { left: 0;   top: 12px; width: 9px; height: 2px; }
.br-reticle__tick--right { right: 0;  top: 12px; width: 9px; height: 2px; }
.br-reticle__tick--up    { left: 12px; top: 0;   width: 2px; height: 9px; }
.br-reticle__tick--down  { left: 12px; bottom: 0; width: 2px; height: 9px; }
.br-reticle__dot         { left: 12px; top: 12px; width: 2px; height: 2px; }

.br-reticle--valid { scale: 1.2 1.2; }
.br-reticle--valid .br-reticle__tick,
.br-reticle--valid .br-reticle__dot { background-color: var(--br-accent); }
.br-reticle--invalid .br-reticle__tick,
.br-reticle--invalid .br-reticle__dot { background-color: #FF4D59; }

/* ---------------------------------------------------------------- feedback (centre) */

.br-toasts {
    position: absolute;
    left: 0;
    right: 0;
    top: 57%;
    align-items: center;
}

.br-toast {
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    padding: 4px 12px;
    margin-bottom: 4px;
    border-radius: 3px;
    background-color: rgba(5, 12, 20, 0.6);
}

.br-toast--negative { border-left-width: 3px; border-left-color: var(--br-alert); }
.br-toast--positive { border-left-width: 3px; border-left-color: var(--br-accent); }

.br-banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 22%;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    color: var(--br-success);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.7);
}

/* ---------------------------------------------------------------- guide (above the dock) */

.br-guide {
    position: absolute;
    bottom: 104px;
    left: 50%;
    max-width: 760px;
    translate: -50% 0;
    padding: 10px 18px 12px 18px;
    border-radius: 4px;
    border-left-width: 4px;
    border-left-color: var(--br-accent);
    background-color: rgba(5, 12, 20, 0.86);
    transition-property: background-color;
    transition-duration: 0.3s;
}

.br-guide--advanced { background-color: rgba(64, 242, 255, 0.35); }

.br-guide__text {
    margin-top: 2px;
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
    color: #FFFFFF;
}

.br-guide-marker {
    position: absolute;
    width: 24px;
    height: 24px;
    translate: -50% -100%;
    transition-property: translate;
    transition-duration: 0.5s;
}

.br-guide-marker--up { translate: -50% -140%; }

.br-guide-marker__diamond {
    position: absolute;
    left: 4px;
    top: 4px;
    width: 16px;
    height: 16px;
    rotate: 45deg;
    border-width: 3px;
    border-color: var(--br-accent);
    background-color: rgba(64, 242, 255, 0.25);
}

/* ---------------------------------------------------------------- objective (bottom-left) */

.br-objective {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 560px;
}

.br-objective__title {
    margin-top: 2px;
    font-size: 22px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.br-objective__hint {
    margin-top: 4px;
    font-size: 14px;
    white-space: normal;
    color: var(--br-text-soft);
}

/* ---------------------------------------------------------------- glitch dock (bottom) */

.br-dock {
    position: absolute;
    bottom: 20px;
    left: 50%;
    translate: -50% 0;
    align-items: center;
}

.br-dock__row,
.br-dock__slots {
    flex-direction: row;
    align-items: center;
}

.br-slot {
    flex-direction: row;
    align-items: center;
    padding: 6px 12px;
    margin: 0 3px;
    border-radius: 3px;
    border-bottom-width: 3px;
    background-color: rgba(5, 12, 20, 0.7);
    opacity: 0.6;
    transition-property: opacity, scale;
    transition-duration: 0.12s;
}

.br-slot--active {
    opacity: 1;
    scale: 1.06 1.06;
}

.br-slot__swatch {
    width: 10px;
    height: 10px;
    margin-right: 8px;
    border-radius: 5px;
}

.br-slot__name {
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: #FFFFFF;
}

.br-slot--cooling .br-slot__name { color: var(--br-text-dim); }

.br-slot__timer {
    margin-left: 6px;
    font-size: 12px;
    color: #FFB3BD;
}

.br-prompt {
    margin-top: 8px;
    padding: 3px 10px;
    border-radius: 3px;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--br-text);
    background-color: rgba(5, 12, 20, 0.7);
}

.br-hud--no-panels .br-prompt { background-color: rgba(0, 0, 0, 0); }

.br-prompt--invalid { color: #FF6B76; }

/* ---------------------------------------------------------------- inspection (world + panel) */

.br-tags {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.br-tag {
    position: absolute;
    translate: -50% -100%;
    padding: 3px 8px;
    border-radius: 3px;
    border-left-width: 2px;
    border-left-color: var(--br-accent);
    background-color: rgba(5, 12, 20, 0.75);
}

.br-tag__line,
.br-tag__pips {
    flex-direction: row;
    align-items: center;
}

.br-tag__name { font-size: 12px; -unity-font-style: bold; }
.br-tag__id   { font-size: 11px; margin-left: 6px; color: var(--br-success); }
.br-tag__pips { margin-top: 3px; }

.br-pip {
    width: 10px;
    height: 6px;
    margin-right: 4px;
    border-radius: 1px;
}

.br-hero-icon {
    position: absolute;
    translate: -50% -100%;
    font-size: 44px;
    -unity-font-style: bold;
    color: #FFD933;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.7);
}

.br-inspect {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 340px;
}

.br-inspect__head {
    flex-direction: row;
    align-items: flex-end;
}

.br-inspect__name { font-size: 18px; -unity-font-style: bold; color: #FFFFFF; }
.br-inspect__id   { font-size: 12px; margin-left: 8px; color: var(--br-success); }

.br-inspect__description {
    margin: 4px 0;
    font-size: 13px;
    -unity-font-style: italic;
    white-space: normal;
    color: var(--br-text-soft);
}

.br-inspect__chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.br-chip {
    font-size: 11px;
    -unity-font-style: bold;
    padding: 2px 6px;
    margin: 0 4px 4px 0;
    border-left-width: 3px;
    background-color: rgba(255, 255, 255, 0.06);
}

.br-inspect__state {
    margin-top: 6px;
    font-size: 13px;
    -unity-font-style: bold;
    color: #9FDCF0;
}

.br-inspect__state--altered { color: #FFD24A; }

/* ---------------------------------------------------------------- menus */

.br-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(2, 6, 10, 0.72);
}

.br-card {
    min-width: 520px;
    padding: 28px 36px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(64, 242, 255, 0.35);
    border-left-width: 4px;
    border-left-color: var(--br-accent);
    background-color: rgba(8, 18, 28, 0.96);
}

.br-card--success { border-left-color: var(--br-success); }

.br-title {
    margin-bottom: 18px;
    font-size: 40px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: #FFFFFF;
}

.br-card__body {
    margin-bottom: 18px;
    font-size: 16px;
    color: var(--br-text-soft);
}

.br-card__columns { flex-direction: row; }
.br-card__buttons { width: 340px; }

.br-button.unity-button {
    height: 44px;
    margin: 0 0 8px 0;
    padding: 0 0 0 16px;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    letter-spacing: 2px;
    color: var(--br-text);
    border-width: 1px;
    border-radius: 3px;
    border-color: rgba(64, 242, 255, 0.35);
    background-color: rgba(64, 242, 255, 0.08);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.br-button.unity-button:hover {
    background-color: rgba(64, 242, 255, 0.22);
}

.br-button.unity-button:focus {
    border-color: var(--br-accent);
    border-left-width: 4px;
    background-color: rgba(64, 242, 255, 0.18);
}

.br-button.unity-button:active {
    background-color: rgba(64, 242, 255, 0.35);
}

.br-controls { margin-left: 32px; }

.br-controls__row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.br-controls .br-key { min-width: 120px; }

.br-controls__action {
    font-size: 13px;
    color: var(--br-text-soft);
}

/* ---------------------------------------------------------------- main menu */

.br-menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    padding-left: 120px;
    background-color: rgba(2, 6, 10, 0.35);
}

.br-menu__home {
    align-items: flex-start;
}

.br-menu__title {
    font-size: 96px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    color: #FFFFFF;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
}

.br-menu__tagline {
    margin-bottom: 28px;
    font-size: 20px;
    color: var(--br-accent);
    letter-spacing: 2px;
}

.br-menu .br-card {
    max-width: 640px;
}

.br-credits {
    white-space: normal;
    font-size: 15px;
}

.br-button.unity-button:disabled {
    opacity: 0.4;
}

/* ---------------------------------------------------------------- settings */

.br-settings {
    min-width: 640px;
}

.br-settings__column {
    width: 520px;
}

.br-settings .br-controls {
    margin-left: 40px;
}

.br-key-button.unity-button {
    min-width: 150px;
    height: 28px;
    margin: 0 10px 0 0;
    padding: 0 8px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #0A1620;
    background-color: var(--br-text-soft);
    border-width: 0;
    border-radius: 3px;
}

.br-key-button.unity-button:hover,
.br-key-button.unity-button:focus {
    background-color: var(--br-accent);
}

.br-setting {
    margin: 0 0 12px 0;
    min-height: 36px;
}

.br-setting .unity-base-field__label,
.br-setting .unity-label {
    min-width: 260px;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--br-text-soft);
}

.br-setting:focus .unity-base-field__label {
    color: var(--br-accent);
}

.br-settings .br-button.unity-button {
    margin-top: 10px;
}

/* ---- level-complete bug report card ---- */
.br-stars { font-size: 56px; letter-spacing: 12px; color: #FFD34D; margin-bottom: 10px; -unity-text-align: middle-center; }
.br-stats { font-size: 18px; letter-spacing: 2px; color: #CFE9F5; margin-bottom: 6px; }
.br-outro { font-size: 20px; color: #E8F2F8; margin-top: 14px; margin-bottom: 14px; max-width: 760px; white-space: normal; }
.br-stamp {
    position: absolute;
    right: 18%;
    top: 16%;
    font-size: 72px;
    letter-spacing: 8px;
    color: rgba(90, 255, 160, 0.8);
    border-width: 5px;
    border-color: rgba(90, 255, 160, 0.8);
    border-radius: 6px;
    padding: 4px 22px;
    rotate: -9deg;
}

/* ---- hero speech bubble ---- */
.br-bubble {
    position: absolute;
    translate: -50% -100%;
    max-width: 320px;
    white-space: normal;
    padding: 8px 14px;
    font-size: 20px;
    color: #10202A;
    background-color: rgba(245, 250, 255, 0.95);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(60, 200, 255, 0.9);
    -unity-text-align: middle-center;
}
