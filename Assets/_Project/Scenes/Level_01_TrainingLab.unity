  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &598402006
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 598402005}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ee4a4a7f663dd4d6389ab9b8f5ad81f2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: BugReport.Runtime::BugReport.Tutorial.GuideDirector
  steps:
  - section: 0
    text: Fly with [W][A][S][D] and the mouse. [SPACE] and [CTRL] move up and down.
    condition: 0
    target: {fileID: 0}
    requireSelected: {fileID: 0}
    glitch: {fileID: 0}
  - section: 0
    text: The hero is stuck behind the blue FIREWALL. Look at it.
    condition: 1
    target: {fileID: 1132547038}
    requireSelected: {fileID: 0}
    glitch: {fileID: 0}
  - section: 0
    text: Press [E] to select the firewall.
    condition: 2
    target: {fileID: 1132547038}
    requireSelected: {fileID: 0}
    glitch: {fileID: 0}
  - section: 0
    text: Now look at the dark SHADOW on the floor.
    condition: 1
    target: {fileID: 399086565}
    requireSelected: {fileID: 1132547038}
    glitch: {fileID: 0}
  - section: 0
    text: 'Click [LMB]: the wall''s solidity moves into the shadow.'
    condition: 4
    target: {fileID: 399086565}
    requireSelected: {fileID: 0}
    glitch: {fileID: 11400000, guid: 96a0fff46e9ee4255b42c3f7c6165a32, type: 2}
  - section: 0
    text: The firewall is a ghost now. Watch the hero walk through.
    condition: 7
    target: {fileID: 0}
    requireSelected: {fileID: 0}
    glitch: {fileID: 0}
  - section: 1
    text: 'New glitch: DUPLICATION. Press [Q] to switch to it.'
    condition: 3
    target: {fileID: 0}
    requireSelected: {fileID: 0}
    glitch: {fileID: 11400000, guid: 73bc2cd1c27c5497385cefc9eab2f554, type: 2}
  - section: 1
    text: Both red plates need weight, and there is one crate. Look at the CRATE.
    condition: 1
    target: {fileID: 1742120998}
    requireSelected: {fileID: 0}
    glitch: {fileID: 0}
  - section: 1
    text: Click [LMB] to copy it. The copy lands on the empty plate.
    condition: 4
    target: {fileID: 1742120998}
    requireSelected: {fileID: 0}
    glitch: {fileID: 11400000, guid: 73bc2cd1c27c5497385cefc9eab2f554, type: 2}
  - section: 1
    text: The gate opens when both plates are pressed. Made a mistake? [R] undoes your last glitch.
    condition: 7
    target: {fileID: 0}
    requireSelected: {fileID: 0}
    glitch: {fileID: 0}
  - section: 2
    text: 'New glitch: FREEZE. Press [Q] until FREEZE is selected.'
    condition: 3
    target: {fileID: 0}
    requireSelected: {fileID: 0}
    glitch: {fileID: 11400000, guid: 89ce58d0ab7e84589ab3e40205b8a156, type: 2}
  - section: 2
    text: The hero won't walk into the moving PISTON. Look at it.
    condition: 1
    target: {fileID: 2039539821}
    requireSelected: {fileID: 0}
    glitch: {fileID: 0}
  - section: 2
    text: Wait until it pulls back out of the corridor, then click [LMB].
    condition: 4
    target: {fileID: 2039539821}
    requireSelected: {fileID: 0}
    glitch: {fileID: 11400000, guid: 89ce58d0ab7e84589ab3e40205b8a156, type: 2}
  - section: 2
    text: Frozen. The hero can pass safely.
    condition: 7
    target: {fileID: 0}
    requireSelected: {fileID: 0}
    glitch: {fileID: 0}
  unlocks:
  - section: 1
    glitch: {fileID: 11400000, guid: 73bc2cd1c27c5497385cefc9eab2f554, type: 2}
  - section: 2
    glitch: {fileID: 11400000, guid: 89ce58d0ab7e84589ab3e40205b8a156, type: 2}
  glitches: {fileID: 1088600808}
  objectives: {fileID: 396978013}
  player: {fileID: 1676252352}
  moveDistance: 2
