<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Type-checks ALL project C# (Core, Runtime, Editor, tests) against
    UnityApiStubs.cs at Unity's language level. Catches errors in our own code;
    does NOT prove the code compiles in Unity (stubs are hand-written).
    The Unity Editor compile remains the authoritative check.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR;UNITY_INCLUDE_TESTS;ENABLE_INPUT_SYSTEM</DefineConstants>
    <NoWarn>CS0649;CS0169</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="UnityApiStubs.cs" />
    <Compile Include="../../Assets/_Project/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
  </ItemGroup>
</Project>
